---
interface Props {
  variant:
    | 'ai-ml'
    | 'media-tech'
    | 'music-audio'
    | 'aerospace'
    | 'robotics'
    | 'creator-economy'
    | 'consumer-software'
    | 'gaming'
    | 'web3';
  label: string;
}
const { variant, label } = Astro.props;
---
<div class="industry-visual" role="img" aria-label={label}>
  {variant === 'ai-ml' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <g stroke="#E0A72B" stroke-width="1.5" opacity="0.5">
        <line class="visual-draw" x1="90" y1="90" x2="200" y2="60" />
        <line class="visual-draw" x1="90" y1="90" x2="150" y2="180" />
        <line class="visual-draw" x1="200" y1="60" x2="290" y2="100" />
        <line class="visual-draw" x1="200" y1="60" x2="150" y2="180" />
        <line class="visual-draw" x1="150" y1="180" x2="290" y2="100" />
        <line class="visual-draw" x1="150" y1="180" x2="230" y2="230" />
        <line class="visual-draw" x1="290" y1="100" x2="230" y2="230" />
        <line class="visual-draw" x1="290" y1="100" x2="330" y2="180" />
        <line class="visual-draw" x1="230" y1="230" x2="330" y2="180" />
      </g>
      <g fill="#E0A72B" class="visual-pulse-group">
        <circle class="visual-pulse-node" cx="90" cy="90" r="6" style="animation-delay:0s" />
        <circle class="visual-pulse-node" cx="200" cy="60" r="8" style="animation-delay:0.3s" />
        <circle class="visual-pulse-node" cx="150" cy="180" r="10" style="animation-delay:0.6s" />
        <circle class="visual-pulse-node" cx="290" cy="100" r="7" style="animation-delay:0.9s" />
        <circle class="visual-pulse-node" cx="230" cy="230" r="9" style="animation-delay:1.2s" />
        <circle class="visual-pulse-node" cx="330" cy="180" r="5" opacity="0.7" style="animation-delay:1.5s" />
      </g>
    </svg>
  )}
  {variant === 'media-tech' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <g fill="none" stroke="#E0A72B" class="visual-ripple-group">
        <circle class="visual-ripple" cx="150" cy="150" r="40" stroke-width="2" style="animation-delay:0s" />
        <circle class="visual-ripple" cx="150" cy="150" r="40" stroke-width="1.5" style="animation-delay:0.8s" />
        <circle class="visual-ripple" cx="150" cy="150" r="40" stroke-width="1.5" style="animation-delay:1.6s" />
      </g>
      <path d="M132 128 L132 172 L172 150 Z" fill="#E0A72B" />
    </svg>
  )}
  {variant === 'music-audio' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <g fill="#E0A72B">
        <rect class="visual-bar visual-eq-bar" x="70" y="210" width="14" height="40" style="animation-delay:0s" />
        <rect class="visual-bar visual-eq-bar" x="94" y="160" width="14" height="90" style="animation-delay:0.1s" />
        <rect class="visual-bar visual-eq-bar" x="118" y="190" width="14" height="60" style="animation-delay:0.2s" />
        <rect class="visual-bar visual-eq-bar" x="142" y="130" width="14" height="120" style="animation-delay:0.3s" />
        <rect class="visual-bar visual-eq-bar" x="166" y="180" width="14" height="70" style="animation-delay:0.4s" />
        <rect class="visual-bar visual-eq-bar" x="190" y="100" width="14" height="150" style="animation-delay:0.5s" />
        <rect class="visual-bar visual-eq-bar" x="214" y="165" width="14" height="85" style="animation-delay:0.6s" />
        <rect class="visual-bar visual-eq-bar" x="238" y="140" width="14" height="110" style="animation-delay:0.7s" />
        <rect class="visual-bar visual-eq-bar" x="262" y="195" width="14" height="55" style="animation-delay:0.8s" />
        <rect class="visual-bar visual-eq-bar" x="286" y="155" width="14" height="95" style="animation-delay:0.9s" />
        <rect class="visual-bar visual-eq-bar" x="310" y="215" width="14" height="35" style="animation-delay:1.0s" />
      </g>
    </svg>
  )}
  {variant === 'aerospace' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <path class="visual-draw" d="M40 240 C 120 240, 160 80, 340 60" fill="none" stroke="#E0A72B" stroke-width="1.5" stroke-dasharray="6 6" opacity="0.6" />
      <path id="visual-flight-path" class="visual-draw" d="M40 200 Q 200 260 350 140" fill="none" stroke="#E0A72B" stroke-width="2" opacity="0.9" />
      <path d="M345 128 L370 140 L345 152 L352 140 Z" fill="#E0A72B" />
      <circle class="visual-orbit-dot" r="5" fill="#F1C24F" data-path="#visual-flight-path" />
    </svg>
  )}
  {variant === 'robotics' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <g stroke="#E0A72B" stroke-width="4" stroke-linecap="round" class="visual-arm-group">
        <line class="visual-draw visual-arm-seg" x1="90" y1="230" x2="150" y2="140" style="transform-origin:90px 230px" />
        <line class="visual-draw visual-arm-seg" x1="150" y1="140" x2="230" y2="160" style="transform-origin:150px 140px" />
        <line class="visual-draw visual-arm-seg" x1="230" y1="160" x2="290" y2="90" style="transform-origin:230px 160px" />
      </g>
      <g fill="#14181C" stroke="#E0A72B" stroke-width="3">
        <circle class="visual-pulse-node" cx="90" cy="230" r="9" style="animation-delay:0s" />
        <circle class="visual-pulse-node" cx="150" cy="140" r="9" style="animation-delay:0.4s" />
        <circle class="visual-pulse-node" cx="230" cy="160" r="9" style="animation-delay:0.8s" />
        <circle class="visual-pulse-node" cx="290" cy="90" r="9" style="animation-delay:1.2s" />
      </g>
    </svg>
  )}
  {variant === 'creator-economy' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <g fill="none" stroke="#E0A72B" class="visual-ripple-group">
        <circle class="visual-ripple" cx="150" cy="150" r="20" stroke-width="2" style="animation-delay:0s" />
        <circle class="visual-ripple" cx="150" cy="150" r="20" stroke-width="1.5" style="animation-delay:0.6s" />
        <circle class="visual-ripple" cx="150" cy="150" r="20" stroke-width="1.5" style="animation-delay:1.2s" />
        <circle class="visual-ripple" cx="150" cy="150" r="20" stroke-width="1.5" style="animation-delay:1.8s" />
      </g>
      <circle cx="150" cy="150" r="7" fill="#E0A72B" />
    </svg>
  )}
  {variant === 'consumer-software' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <g fill="none" stroke="#E0A72B" stroke-width="1.5">
        <rect class="visual-draw visual-window" x="60" y="180" width="180" height="70" rx="6" opacity="0.5" style="animation-delay:0.6s" />
        <rect class="visual-draw visual-window" x="100" y="130" width="180" height="70" rx="6" opacity="0.75" style="animation-delay:0.3s" />
        <rect class="visual-draw visual-window" x="140" y="80" width="180" height="70" rx="6" style="animation-delay:0s" />
      </g>
      <line x1="140" y1="96" x2="320" y2="96" stroke="#E0A72B" stroke-width="1" opacity="0.5" />
      <circle class="visual-blink" cx="152" cy="96" r="3" fill="#E0A72B" style="animation-delay:0s" />
      <circle class="visual-blink" cx="164" cy="96" r="3" fill="#E0A72B" opacity="0.6" style="animation-delay:0.4s" />
      <circle class="visual-blink" cx="176" cy="96" r="3" fill="#E0A72B" opacity="0.4" style="animation-delay:0.8s" />
    </svg>
  )}
  {variant === 'gaming' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <g fill="#E0A72B" class="visual-twinkle-group">
        <rect class="visual-pixel visual-twinkle" x="142" y="142" width="16" height="16" style="animation-delay:0s" />
        <rect class="visual-pixel visual-twinkle" x="180" y="130" width="14" height="14" style="animation-delay:0.15s" />
        <rect class="visual-pixel visual-twinkle" x="110" y="120" width="12" height="12" style="animation-delay:0.3s" />
        <rect class="visual-pixel visual-twinkle" x="200" y="180" width="12" height="12" style="animation-delay:0.45s" />
        <rect class="visual-pixel visual-twinkle" x="100" y="180" width="10" height="10" style="animation-delay:0.6s" />
        <rect class="visual-pixel visual-twinkle" x="230" y="110" width="10" height="10" style="animation-delay:0.75s" />
        <rect class="visual-pixel visual-twinkle" x="150" y="200" width="10" height="10" style="animation-delay:0.9s" />
        <rect class="visual-pixel visual-twinkle" x="260" y="160" width="8" height="8" style="animation-delay:1.05s" />
        <rect class="visual-pixel visual-twinkle" x="80" y="150" width="8" height="8" style="animation-delay:1.2s" />
      </g>
    </svg>
  )}
  {variant === 'web3' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <g stroke="#E0A72B" stroke-width="1.5" opacity="0.55">
        <line class="visual-draw" x1="120" y1="90" x2="220" y2="90" />
        <line class="visual-draw" x1="220" y1="90" x2="280" y2="150" />
        <line class="visual-draw" x1="280" y1="150" x2="220" y2="210" />
        <line class="visual-draw" x1="220" y1="210" x2="120" y2="210" />
        <line class="visual-draw" x1="120" y1="210" x2="90" y2="150" />
        <line class="visual-draw" x1="90" y1="150" x2="120" y2="90" />
        <line class="visual-draw" x1="90" y1="150" x2="220" y2="90" />
        <line class="visual-draw" x1="90" y1="150" x2="220" y2="210" />
      </g>
      <g fill="#E0A72B" class="visual-mesh-group">
        <circle class="visual-pulse-node" cx="120" cy="90" r="6" style="animation-delay:0s" />
        <circle class="visual-pulse-node" cx="220" cy="90" r="6" style="animation-delay:0.2s" />
        <circle class="visual-pulse-node" cx="280" cy="150" r="6" style="animation-delay:0.4s" />
        <circle class="visual-pulse-node" cx="220" cy="210" r="6" style="animation-delay:0.6s" />
        <circle class="visual-pulse-node" cx="120" cy="210" r="6" style="animation-delay:0.8s" />
        <circle class="visual-pulse-node" cx="90" cy="150" r="6" style="animation-delay:1.0s" />
      </g>
    </svg>
  )}
</div>

<style>
  .industry-visual{
    width:100%; height:100%; aspect-ratio:4/3; border-radius:16px; overflow:hidden;
    background:#14181C;
  }
  .industry-visual svg{ width:100%; height:100%; display:block }
  .visual-bar{ transform-box:fill-box; }
  .visual-pulse-node, .visual-ripple, .visual-blink, .visual-twinkle{ transform-box:fill-box; transform-origin:center; }

  /* Continuous ambient loops, pure CSS: never touched by the scroll-triggered
     GSAP draw-in (different elements or different properties), so there is
     no repeat of the opacity/transform race that broke the first pass. */
  @media (prefers-reduced-motion: no-preference){
    .visual-pulse-node{ animation:visual-pulse 2.2s ease-in-out infinite; }
    .visual-ripple{ animation:visual-ripple 2.4s ease-out infinite; }
    .visual-eq-bar{ animation:visual-eq 0.9s ease-in-out infinite; }
    .visual-blink{ animation:visual-blink 2.4s ease-in-out infinite; }
    .visual-twinkle{ animation:visual-twinkle 1.8s ease-in-out infinite; }
  }
  @keyframes visual-pulse{ 0%,100%{ transform:scale(1); opacity:1 } 50%{ transform:scale(1.35); opacity:0.55 } }
  @keyframes visual-ripple{ 0%{ transform:scale(0.3); opacity:0.9 } 100%{ transform:scale(2.6); opacity:0 } }
  @keyframes visual-eq{ 0%,100%{ transform:scaleY(0.45) } 50%{ transform:scaleY(1) } }
  @keyframes visual-blink{ 0%,100%{ opacity:1 } 50%{ opacity:0.25 } }
  @keyframes visual-twinkle{ 0%,100%{ opacity:1; transform:scale(1) } 50%{ opacity:0.3; transform:scale(0.7) } }
</style>
