---
interface Props {
  variant:
    | 'ai-ml'
    | 'media-tech'
    | 'music-audio'
    | 'aerospace'
    | 'robotics'
    | 'creator-economy'
    | 'consumer-software'
    | 'gaming'
    | 'web3';
  label: string;
}
const { variant, label } = Astro.props;
---
<div class="industry-visual" role="img" aria-label={label}>
  {variant === 'ai-ml' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <g stroke="#E0A72B" stroke-width="1.5" opacity="0.5">
        <line class="visual-draw" x1="90" y1="90" x2="200" y2="60" />
        <line class="visual-draw" x1="90" y1="90" x2="150" y2="180" />
        <line class="visual-draw" x1="200" y1="60" x2="290" y2="100" />
        <line class="visual-draw" x1="200" y1="60" x2="150" y2="180" />
        <line class="visual-draw" x1="150" y1="180" x2="290" y2="100" />
        <line class="visual-draw" x1="150" y1="180" x2="230" y2="230" />
        <line class="visual-draw" x1="290" y1="100" x2="230" y2="230" />
        <line class="visual-draw" x1="290" y1="100" x2="330" y2="180" />
        <line class="visual-draw" x1="230" y1="230" x2="330" y2="180" />
      </g>
      <g fill="#E0A72B">
        <circle cx="90" cy="90" r="6" />
        <circle cx="200" cy="60" r="8" />
        <circle cx="150" cy="180" r="10" />
        <circle cx="290" cy="100" r="7" />
        <circle cx="230" cy="230" r="9" />
        <circle cx="330" cy="180" r="5" opacity="0.7" />
      </g>
    </svg>
  )}
  {variant === 'media-tech' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <g fill="none" stroke="#E0A72B">
        <circle class="visual-draw" cx="150" cy="150" r="40" stroke-width="2" opacity="0.9" />
        <circle class="visual-draw" cx="150" cy="150" r="75" stroke-width="1.5" opacity="0.6" />
        <circle class="visual-draw" cx="150" cy="150" r="110" stroke-width="1.5" opacity="0.35" />
      </g>
      <path d="M132 128 L132 172 L172 150 Z" fill="#E0A72B" />
    </svg>
  )}
  {variant === 'music-audio' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <g fill="#E0A72B">
        <rect class="visual-bar" x="70" y="210" width="14" height="40" />
        <rect class="visual-bar" x="94" y="160" width="14" height="90" />
        <rect class="visual-bar" x="118" y="190" width="14" height="60" />
        <rect class="visual-bar" x="142" y="130" width="14" height="120" />
        <rect class="visual-bar" x="166" y="180" width="14" height="70" />
        <rect class="visual-bar" x="190" y="100" width="14" height="150" />
        <rect class="visual-bar" x="214" y="165" width="14" height="85" />
        <rect class="visual-bar" x="238" y="140" width="14" height="110" />
        <rect class="visual-bar" x="262" y="195" width="14" height="55" />
        <rect class="visual-bar" x="286" y="155" width="14" height="95" />
        <rect class="visual-bar" x="310" y="215" width="14" height="35" />
      </g>
    </svg>
  )}
  {variant === 'aerospace' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <path class="visual-draw" d="M40 240 C 120 240, 160 80, 340 60" fill="none" stroke="#E0A72B" stroke-width="1.5" stroke-dasharray="6 6" opacity="0.6" />
      <path class="visual-draw" d="M40 200 Q 200 260 350 140" fill="none" stroke="#E0A72B" stroke-width="2" opacity="0.9" />
      <path d="M345 128 L370 140 L345 152 L352 140 Z" fill="#E0A72B" />
    </svg>
  )}
  {variant === 'robotics' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <g stroke="#E0A72B" stroke-width="4" stroke-linecap="round">
        <line class="visual-draw" x1="90" y1="230" x2="150" y2="140" />
        <line class="visual-draw" x1="150" y1="140" x2="230" y2="160" />
        <line class="visual-draw" x1="230" y1="160" x2="290" y2="90" />
      </g>
      <g fill="#14181C" stroke="#E0A72B" stroke-width="3">
        <circle cx="90" cy="230" r="9" />
        <circle cx="150" cy="140" r="9" />
        <circle cx="230" cy="160" r="9" />
        <circle cx="290" cy="90" r="9" />
      </g>
    </svg>
  )}
  {variant === 'creator-economy' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <g fill="none" stroke="#E0A72B">
        <circle class="visual-draw" cx="150" cy="150" r="20" stroke-width="2" />
        <circle class="visual-draw" cx="150" cy="150" r="55" stroke-width="1.5" stroke-dasharray="4 6" opacity="0.7" />
        <circle class="visual-draw" cx="150" cy="150" r="90" stroke-width="1.5" stroke-dasharray="4 6" opacity="0.45" />
        <circle class="visual-draw" cx="150" cy="150" r="125" stroke-width="1.5" stroke-dasharray="4 6" opacity="0.25" />
      </g>
      <circle cx="150" cy="150" r="7" fill="#E0A72B" />
    </svg>
  )}
  {variant === 'consumer-software' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <g fill="none" stroke="#E0A72B" stroke-width="1.5">
        <rect class="visual-draw" x="60" y="180" width="180" height="70" rx="6" opacity="0.5" />
        <rect class="visual-draw" x="100" y="130" width="180" height="70" rx="6" opacity="0.75" />
        <rect class="visual-draw" x="140" y="80" width="180" height="70" rx="6" />
      </g>
      <line x1="140" y1="96" x2="320" y2="96" stroke="#E0A72B" stroke-width="1" opacity="0.5" />
      <circle cx="152" cy="96" r="3" fill="#E0A72B" />
      <circle cx="164" cy="96" r="3" fill="#E0A72B" opacity="0.6" />
    </svg>
  )}
  {variant === 'gaming' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <g fill="#E0A72B">
        <rect class="visual-pixel" x="142" y="142" width="16" height="16" />
        <rect class="visual-pixel" x="180" y="130" width="14" height="14" opacity="0.85" />
        <rect class="visual-pixel" x="110" y="120" width="12" height="12" opacity="0.75" />
        <rect class="visual-pixel" x="200" y="180" width="12" height="12" opacity="0.7" />
        <rect class="visual-pixel" x="100" y="180" width="10" height="10" opacity="0.6" />
        <rect class="visual-pixel" x="230" y="110" width="10" height="10" opacity="0.55" />
        <rect class="visual-pixel" x="150" y="200" width="10" height="10" opacity="0.5" />
        <rect class="visual-pixel" x="260" y="160" width="8" height="8" opacity="0.4" />
        <rect class="visual-pixel" x="80" y="150" width="8" height="8" opacity="0.4" />
      </g>
    </svg>
  )}
  {variant === 'web3' && (
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" fill="#14181C" />
      <g stroke="#E0A72B" stroke-width="1.5" opacity="0.55">
        <line class="visual-draw" x1="120" y1="90" x2="220" y2="90" />
        <line class="visual-draw" x1="220" y1="90" x2="280" y2="150" />
        <line class="visual-draw" x1="280" y1="150" x2="220" y2="210" />
        <line class="visual-draw" x1="220" y1="210" x2="120" y2="210" />
        <line class="visual-draw" x1="120" y1="210" x2="90" y2="150" />
        <line class="visual-draw" x1="90" y1="150" x2="120" y2="90" />
        <line class="visual-draw" x1="90" y1="150" x2="220" y2="90" />
        <line class="visual-draw" x1="90" y1="150" x2="220" y2="210" />
      </g>
      <g fill="#E0A72B">
        <circle cx="120" cy="90" r="6" /><circle cx="220" cy="90" r="6" />
        <circle cx="280" cy="150" r="6" /><circle cx="220" cy="210" r="6" />
        <circle cx="120" cy="210" r="6" /><circle cx="90" cy="150" r="6" />
      </g>
    </svg>
  )}
</div>

<style>
  .industry-visual{
    width:100%; height:100%; aspect-ratio:4/3; border-radius:16px; overflow:hidden;
    background:#14181C;
  }
  .industry-visual svg{ width:100%; height:100%; display:block }
  .visual-bar{ transform-box:fill-box; }
</style>
